{
  "name": "ammotors-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Simple Express API for the AMMOTORS website",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "test:rules": "firebase emulators:exec --project demo-ammotors --only firestore,storage \"node --test test/securityRules.emulator.test.js\"",
    "migrate:cars": "node --env-file-if-exists=.env scripts/migrateCars.js",
    "admin:grant": "node --env-file-if-exists=.env scripts/setAdminClaim.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^14.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.2"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "^11.1.1"
    }
  }
}

PORT=5000
CORS_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional for now. Add this after enabling Firebase Storage for car-image uploads.
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# Set this to the absolute path of a service-account JSON file only outside Google-managed hosting.
# Never copy the JSON into this repository or commit it.
GOOGLE_APPLICATION_CREDENTIALS=C:\secure\path\ammotors-service-account.json
